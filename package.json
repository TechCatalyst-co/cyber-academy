{
  "name": "cyber-academy",
  "version": "1.0.0",
  "description": "TechCatalyst Cyber Academy: multi-tenant security awareness LMS",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch server/index.js",
    "seed": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"tests/**/*.test.js\" && TEST_STORE=mongo-adapter node --no-warnings=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "test:mongo": "TEST_STORE=mongo node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "build:demo": "node scripts/build-demo.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "mongodb": "^6.21.0"
  }
}
