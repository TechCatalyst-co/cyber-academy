# Copy to .env; npm start / dev / seed load it automatically. On Render, set these in the dashboard instead.
NODE_ENV=production
PORT=3000

# MongoDB Atlas (Connect > Drivers > Node.js). Use a database user with readWrite on MONGODB_DB only.
MONGODB_URI=mongodb+srv://cyber_academy_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=cyber-academy
MONGODB_DB=cyber_academy

# 48+ random characters; every server instance must share it. e.g. openssl rand -base64 48
SESSION_SECRET=replace-me

# Creates the first TechCatalyst provider admin on first start (then remove these two lines).
ADMIN_EMAIL=you@techcatalyst.co
ADMIN_PASSWORD=replace-with-a-long-passphrase
ADMIN_NAME=Your Name

BRAND_NAME=Cyber Academy
HSTS=1
